<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Console</RootNamespace>
    <AssemblyName>Console</AssemblyName>
    <!-- The scenarios open sample.pdf, sample.xml and the PFX by relative path, so `dotnet run` starts
         in the output folder, as Visual Studio does. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Signer client: brings in Lacuna.Signer.Api (the request and response models) and Lacuna.RestClient. -->
    <PackageReference Include="Lacuna.Signer.Client" Version="1.24.0" />
    <!-- Newer than the 1.67.0 the client asks for. 2.x needs a prerelease Lacuna.Spa.Api. -->
    <PackageReference Include="Lacuna.Signer.Api" Version="1.77.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests run the scenarios, some of which are internal. -->
    <InternalsVisibleTo Include="Console.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Input files the scenarios open by relative path, from the output folder. -->
    <None Update="sample.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="sample.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="sample-degree.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
